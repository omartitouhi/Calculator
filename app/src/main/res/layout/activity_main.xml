<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Affichage du calcul -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#263238"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:gravity="end|bottom"
        android:padding="24dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Zone des boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Ligne 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="AC" android:textSize="20sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnDEL" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="DEL" android:textSize="20sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="%" android:textSize="24sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="÷" android:textSize="28sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Ligne 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="×" android:textSize="28sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Ligne 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="−" android:textSize="28sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Ligne 4 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+" android:textSize="28sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Ligne 5 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnSign" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+/-" android:textSize="20sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:text="0" android:textSize="24sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="." android:textSize="28sp" android:backgroundTint="#455A64" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="=" android:textSize="28sp" android:backgroundTint="#FF5722" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Historique -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historique"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#ECEFF1"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>
    </ScrollView>

</LinearLayout>